# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# `change_me` không an toàn ngoài test. Local demo phải đặt ALLOW_INSECURE_DEFAULTS=1 hoặc dùng password thật.
DATABASE_URL=postgres://hrm_rag_user:hrm-rag-db-local@127.0.0.1:15432/hrm_rag
DATABASE_POOL_SIZE=32
API_BIND_ADDR=127.0.0.1:18083
# Public, same-origin Swagger UI and OpenAPI spec. Set false to return 404 in production.
DOCS_ENABLED=true
ALLOW_INSECURE_DEFAULTS=1

# -----------------------------------------------------------------------------
# HRM mode (bắt buộc khi tích hợp HRM)
# -----------------------------------------------------------------------------
# HRM_MODE=true: bỏ qua Keycloak, xác thực bằng token HS512 do HRM ký, và bật
# alias `hrm` ở vị trí {workspace_id} (resolve về HRM_WORKSPACE_ID).
# HRM_MODE=false (mặc định): giữ nguyên luồng Keycloak/RS256, alias `hrm` KHÔNG resolve.
HRM_MODE=false
# Bắt buộc khi HRM_MODE=true. Phải là UUID hợp lệ, nếu không API từ chối khởi động.
HRM_TENANT_ID=
HRM_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# Bearer JWT issuer / JWKS (required for API)
# -----------------------------------------------------------------------------
APP_ENV=development
# RS256 (Keycloak) hoặc HS512 (HRM shared secret). Mặc định RS256.
JWT_ALG=RS256
JWT_ISSUER=http://127.0.0.1:18080/realms/gmrag
# Claim chứa user id. Keycloak dùng `sub`; HRM dùng `userid`. Mặc định `sub`.
JWT_SUBJECT_CLAIM=sub
JWT_AUDIENCE=gmrag-api
JWT_VERIFY_AUDIENCE=true
# Chỉ dùng khi JWT_ALG=RS256.
JWT_JWKS_URL=http://127.0.0.1:18080/realms/gmrag/protocol/openid-connect/certs
# Chỉ dùng khi JWT_ALG=HS512. Shared secret do HRM cấp, tối thiểu 64 byte.
# KHÔNG bao giờ ghi giá trị thật vào file này — chỉ đặt trong .env không commit.
JWT_HMAC_SECRET=

# -----------------------------------------------------------------------------
# DeepSeek — chat streaming and graph extraction (required)
# -----------------------------------------------------------------------------
# Placeholder này không an toàn ngoài test. Local demo phải đặt ALLOW_INSECURE_DEFAULTS=1 hoặc dùng key thật.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_GRAPH_MAX_TOKENS=32768

# -----------------------------------------------------------------------------
# Ollama — batch embeddings (required for ingestion and chat retrieval)
# -----------------------------------------------------------------------------
# ADR-21: ingestion (chunk) và chat (query) bắt buộc dùng chung model này.
# Khuyến nghị / mặc định: AITeamVN/Vietnamese_Embedding (native 1024-d).
# Ollama chạy trong Compose và publish 11435 cho API chạy trên host.
# Import GGUF q8_0 theo docs/RUNBOOK.md; tên import phải khớp chính xác dòng dưới.
# Môi trường legacy vẫn có thể override, nhưng model khác bản ghim sẽ giảm chất
# lượng retrieval tiếng Việt và có thể lệch chiều pgvector/Qdrant; dữ liệu đã
# lưu phải được re-embed toàn bộ khi đổi model.
OLLAMA_EMBED_URL=http://127.0.0.1:11435/api/embed
# Legacy alias (optional): OLLAMA_EMBEDDINGS_URL=http://127.0.0.1:11435/api/embeddings
OLLAMA_EMBED_MODEL=AITeamVN/Vietnamese_Embedding

# -----------------------------------------------------------------------------
# Qdrant retrieval (required for Phase 2 chat retrieval)
# -----------------------------------------------------------------------------
# API chạy trên host nên dùng port Qdrant do Compose publish.
# ingestion-worker trong Compose tự dùng http://qdrant:6333 qua service DNS.
QDRANT_URL=http://127.0.0.1:16333
QDRANT_COLLECTION=hrm_rag_document_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_TOP_K=5
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Object Storage and HTTP
# -----------------------------------------------------------------------------
# UPLOAD_DIR chỉ dùng cho temp processing nếu parser cần file path,
# không còn là source of truth cho original PDF.
UPLOAD_DIR=./data/uploads
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=hrm-rag-documents
# Placeholder MinIO này không an toàn ngoài test. Local demo phải đặt ALLOW_INSECURE_DEFAULTS=1 hoặc dùng credential thật.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECS=900
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Ingestion
# Worker tuần tự nhờ INGESTION_JOB_BATCH_SIZE default 1 (jobs.rs:51).
# -----------------------------------------------------------------------------
INGESTION_WORKER_POLL_INTERVAL_MS=1000
INGESTION_JOB_LEASE_SECS=300
INGESTION_JOB_MAX_ATTEMPTS=5
INGESTION_JOB_BATCH_SIZE=1
INGESTION_JOB_BASE_BACKOFF_SECS=5
INGESTION_JOB_MAX_BACKOFF_SECS=300

# -----------------------------------------------------------------------------
# Ingestion — PDF parsing
# -----------------------------------------------------------------------------
GMRAG_PDF_PARSE_TIMEOUT_SECS=120

# -----------------------------------------------------------------------------
# Ingestion — Ollama embedding batches
# -----------------------------------------------------------------------------
GMRAG_EMBEDDING_BATCH_SIZE=32
GMRAG_EMBEDDING_CONCURRENCY=2
GMRAG_EMBEDDING_TIMEOUT_SECS=120
GMRAG_EMBEDDING_RETRIES=1
GMRAG_EMBEDDING_RETRY_BACKOFF_MS=250

# -----------------------------------------------------------------------------
# Ingestion — DeepSeek graph extraction (per chunk, bounded concurrency)
# -----------------------------------------------------------------------------
GMRAG_GRAPH_EXTRACTION_ENABLED=false
GMRAG_GRAPH_EXTRACTION_CONCURRENCY=12
GMRAG_GRAPH_EXTRACTION_TIMEOUT_SECS=60
GMRAG_GRAPH_EXTRACTION_RETRIES=0
GMRAG_GRAPH_EXTRACTION_STAGE_TIMEOUT_SECS=300
GMRAG_GRAPH_EXTRACTION_RETRY_BACKOFF_MS=250

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# RUST_LOG=info,lopdf=error

# -----------------------------------------------------------------------------
# OpenFGA (required for authorization)
# -----------------------------------------------------------------------------
OPENFGA_API_URL=http://127.0.0.1:18081
OPENFGA_STORE_ID=your-openfga-store-id
OPENFGA_MODEL_ID=your-openfga-model-id
# Preshared token cho OpenFGA. Bắt buộc khi OPENFGA_AUTHN_METHOD=preshared.
# Phải trùng giá trị OPENFGA_API_TOKEN trong root .env; thiếu sẽ ra 401 chứ không
# phải lỗi startup rõ ràng.
OPENFGA_API_TOKEN=
AUTHZ_OUTBOX_BATCH_SIZE=50
AUTHZ_OUTBOX_MAX_RETRIES=5

# -----------------------------------------------------------------------------
# Keycloak admin lookup (required for tenant-owner bootstrap and member addition)
# -----------------------------------------------------------------------------
# Docker network hostname (khi API chạy trong compose network).
# Host-side `cargo run`: dùng http://localhost:8080.
# Repo này không dựng Keycloak; trỏ vào một instance có sẵn.
# Chỉ dùng khi HRM_MODE=false — production chạy HRM_MODE=true, không có Keycloak.
KEYCLOAK_ADMIN_URL=http://127.0.0.1:18080
KEYCLOAK_REALM=gmrag
KEYCLOAK_CLIENT_ID=gmrag-admin-client
# Thay bằng secret thật; không commit credential production vào file này.
KEYCLOAK_CLIENT_SECRET=replace_with_keycloak_admin_client_secret

