# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://gmrag_user:change_me@127.0.0.1:5432/gmrag
DATABASE_POOL_SIZE=32

# -----------------------------------------------------------------------------
# Bearer JWT issuer / JWKS (required for API)
# -----------------------------------------------------------------------------
# Lưu ý: code hiện tại vẫn đọc issuer URL qua tên biến môi trường legacy này.
# Hãy điền issuer URL thực tế của hệ identity đang phát bearer token.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Legacy compatibility webhook secret for POST /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# -----------------------------------------------------------------------------
# DeepSeek — chat streaming and graph extraction (required)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_GRAPH_MAX_TOKENS=32768

# -----------------------------------------------------------------------------
# Ollama — batch embeddings (required for ingestion and chat retrieval)
# -----------------------------------------------------------------------------
# ADR-21: ingestion (chunk) and chat (query) MUST share this model.
# Recommended / default: AITeamVN/Vietnamese_Embedding (768-d).
# Ollama runs outside Docker — pull on the host:
#   ollama pull AITeamVN/Vietnamese_Embedding
# Override is supported for legacy envs, but any model other than the pinned
# one degrades Vietnamese retrieval quality and may break dim compatibility
# with document_chunks.embedding vector(768) / Qdrant (requires full re-embed).
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
# Legacy alias (optional): OLLAMA_EMBEDDINGS_URL=http://127.0.0.1:11434/api/embeddings
OLLAMA_EMBED_MODEL=AITeamVN/Vietnamese_Embedding

# -----------------------------------------------------------------------------
# Qdrant retrieval (required for Phase 2 chat retrieval)
# -----------------------------------------------------------------------------
# Docker network hostname (khi API chạy trong compose network).
# Host-side `cargo run`: dùng http://127.0.0.1:6333 (default trong code).
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=gmrag_document_chunks
QDRANT_VECTOR_SIZE=768
QDRANT_TOP_K=5
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Object Storage and HTTP
# -----------------------------------------------------------------------------
# UPLOAD_DIR chỉ dùng cho temp processing nếu parser cần file path,
# không còn là source of truth cho original PDF.
UPLOAD_DIR=./data/uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gmrag-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECS=900
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Ingestion — document-level concurrency
# -----------------------------------------------------------------------------
GMRAG_INGESTION_DOCUMENT_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Ingestion — PDF parsing
# -----------------------------------------------------------------------------
GMRAG_PDF_PARSE_TIMEOUT_SECS=120

# -----------------------------------------------------------------------------
# Ingestion — Ollama embedding batches
# -----------------------------------------------------------------------------
GMRAG_EMBEDDING_BATCH_SIZE=32
GMRAG_EMBEDDING_CONCURRENCY=2
GMRAG_EMBEDDING_TIMEOUT_SECS=120
GMRAG_EMBEDDING_RETRIES=1
GMRAG_EMBEDDING_RETRY_BACKOFF_MS=250

# -----------------------------------------------------------------------------
# Ingestion — DeepSeek graph extraction (per chunk, bounded concurrency)
# -----------------------------------------------------------------------------
GMRAG_GRAPH_EXTRACTION_ENABLED=true
GMRAG_GRAPH_EXTRACTION_CONCURRENCY=12
GMRAG_GRAPH_EXTRACTION_TIMEOUT_SECS=20
GMRAG_GRAPH_EXTRACTION_RETRIES=0
GMRAG_GRAPH_EXTRACTION_STAGE_TIMEOUT_SECS=30
GMRAG_GRAPH_EXTRACTION_RETRY_BACKOFF_MS=250

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# RUST_LOG=info,lopdf=error

# -----------------------------------------------------------------------------
# OpenFGA (required for authorization)
# -----------------------------------------------------------------------------
OPENFGA_API_URL=http://localhost:8081
OPENFGA_STORE_ID=your-openfga-store-id
OPENFGA_MODEL_ID=your-openfga-model-id
AUTHZ_OUTBOX_BATCH_SIZE=50
AUTHZ_OUTBOX_MAX_RETRIES=5

# -----------------------------------------------------------------------------
# Keycloak admin lookup (required for tenant-owner bootstrap)
# -----------------------------------------------------------------------------
# Docker network hostname (khi API chạy trong compose network).
# Host-side `cargo run`: dùng http://localhost:8080 (default trong code).
# Realm + client được import từ docker/keycloak/gmrag-realm.json lúc start-dev.
# Secret dưới đây khớp secret demo trong realm export (chỉ dùng local, không production).
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=gmrag
KEYCLOAK_CLIENT_ID=gmrag-admin-client
KEYCLOAK_CLIENT_SECRET=gmrag-admin-client-secret

