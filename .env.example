APP_ENV=test
ALLOW_IDENTITY_E2E=1
ALLOW_LOCAL_TEST_SEED=1

POSTGRES_USER=gmrag_user
POSTGRES_PASSWORD=
POSTGRES_DB=gmrag
OPENFGA_DB_USER=fga_user
OPENFGA_DB_PASSWORD=
OPENFGA_DB_NAME=openfga
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_BUCKET=gmrag-documents
QDRANT_COLLECTION=gmrag_document_chunks
QDRANT_VECTOR_SIZE=1024
OLLAMA_EMBED_MODEL=AITeamVN/Vietnamese_Embedding
# Bắt buộc cho ingestion-worker khi GMRAG_GRAPH_EXTRACTION_ENABLED=true.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
GMRAG_GRAPH_EXTRACTION_TIMEOUT_SECS=60
GMRAG_GRAPH_EXTRACTION_STAGE_TIMEOUT_SECS=300
OPENFGA_API_URL=http://localhost:8081
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
# Preshared token cho OpenFGA. Bắt buộc khi OPENFGA_AUTHN_METHOD=preshared.
OPENFGA_API_TOKEN=

KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_REALM=gmrag
KEYCLOAK_CLIENT_ID=gmrag-admin-client
# Secret của hai confidential client khai báo trong docker/keycloak/gmrag-realm.json.
# Realm file chỉ giữ placeholder ${TÊN_BIẾN}; giá trị thật đặt ở đây, không bao giờ commit.
# Lưu ý: Keycloak KHÔNG thay thế dạng ${env.TÊN_BIẾN} — chỉ dạng ${TÊN_BIẾN} mới hoạt động.
KEYCLOAK_CLIENT_SECRET=
GMRAG_E2E_CLIENT_SECRET=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

BROWSER_SMOKE_USERNAME=super.test
BROWSER_SMOKE_PASSWORD=
