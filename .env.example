APP_ENV=test
ALLOW_LOCAL_TEST_SEED=1

POSTGRES_USER=hrm_rag_user
POSTGRES_PASSWORD=hrm-rag-db-local
POSTGRES_DB=hrm_rag
OPENFGA_DB_USER=hrm_fga_user
OPENFGA_DB_PASSWORD=hrm-fga-db-local
OPENFGA_DB_NAME=hrm_rag_openfga
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_BUCKET=hrm-rag-documents
QDRANT_COLLECTION=hrm_rag_document_chunks
QDRANT_VECTOR_SIZE=1024
OLLAMA_EMBED_MODEL=AITeamVN/Vietnamese_Embedding
# Graph extraction tắt trong Phase 1; DEEPSEEK vẫn là dependency của chat.
GMRAG_GRAPH_EXTRACTION_ENABLED=false
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
GMRAG_GRAPH_EXTRACTION_TIMEOUT_SECS=60
GMRAG_GRAPH_EXTRACTION_STAGE_TIMEOUT_SECS=300
API_BIND_ADDR=127.0.0.1:18083
# Public, same-origin Swagger UI and OpenAPI spec. Set false to return 404 in production.
DOCS_ENABLED=true
DATABASE_URL=postgres://hrm_rag_user:hrm-rag-db-local@127.0.0.1:15432/hrm_rag
OPENFGA_API_URL=http://127.0.0.1:18081
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
# Preshared token cho OpenFGA. Bắt buộc khi OPENFGA_AUTHN_METHOD=preshared.
OPENFGA_API_TOKEN=

# --- HRM mode ---------------------------------------------------------------
# true = xác thực bằng token HS512 do HRM ký, bỏ Keycloak, bật alias `hrm`
# ở vị trí {workspace_id}. false = giữ nguyên luồng Keycloak/RS256.
HRM_MODE=false
# Bắt buộc (UUID) khi HRM_MODE=true.
HRM_TENANT_ID=
HRM_WORKSPACE_ID=
# RS256 (Keycloak) hoặc HS512 (HRM). JWT_SUBJECT_CLAIM: `sub` cho Keycloak, `userid` cho HRM.
JWT_ALG=RS256
JWT_ISSUER=
JWT_SUBJECT_CLAIM=sub
JWT_VERIFY_AUDIENCE=true
# Chỉ dùng khi JWT_ALG=HS512. Shared secret do HRM cấp, tối thiểu 64 byte.
# KHÔNG ghi giá trị thật vào file này — chỉ đặt trong .env không commit.
JWT_HMAC_SECRET=

# Chỉ dùng khi HRM_MODE=false. Repo này không dựng Keycloak nữa — trỏ vào một
# instance có sẵn. Test tích hợp chỉ cần bốn biến này tồn tại
# (KeycloakClient::from_env) vì chúng chạy với TEST_BYPASS_KEYCLOAK=1.
KEYCLOAK_ADMIN_URL=http://127.0.0.1:18080
KEYCLOAK_REALM=gmrag
KEYCLOAK_CLIENT_ID=gmrag-admin-client
KEYCLOAK_CLIENT_SECRET=
